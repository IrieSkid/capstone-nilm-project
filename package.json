    "install:all": "npm install --prefix server && npm install --prefix mobile && npm install --prefix engineering-mobile",
    "dev:engineering": "npm run start --prefix engineering-mobile",
    "dev:mobile": "npm run start --prefix mobile",
    "dev:server": "npm run dev --prefix server",
    "dev:feeder": "npm run feeder:dev --prefix server",
    "db:reset": "npm run db:reset --prefix server",
    "db:migrate:rbac": "npm run db:migrate:rbac --prefix server",
    "db:migrate:landlord": "npm run db:migrate:landlord --prefix server",
    "db:migrate:billing": "npm run db:migrate:billing --prefix server",
    "db:migrate:notifications": "npm run db:migrate:notifications --prefix server",
    "db:migrate:pzem": "npm run db:migrate:pzem --prefix server",
    "db:migrate:health": "npm run db:migrate:health --prefix server",
    "db:sync:appliances": "npm run db:sync:appliances --prefix server",
    "typecheck:server": "npm run typecheck --prefix server",
    "typecheck:engineering": "npm run typecheck --prefix engineering-mobile",
    "lint:engineering": "npm run lint --prefix engineering-mobile",
    "lint:mobile": "npm run lint --prefix mobile",
